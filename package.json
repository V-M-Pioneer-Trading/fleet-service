{
  "name": "fleet-service",
  "version": "1.0.0",
  "description": "Ship action commands (navigate, orbit, dock, extract, etc.) for the SpaceTraders mining POC",
  "main": "dist/server.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsoa spec-and-routes && tsc",
    "start": "node dist/server.js",
    "dev": "npm run build && npm start",
    "openapi": "tsoa spec && node scripts/write-openapi.cjs",
    "pretest": "tsoa spec-and-routes",
    "test": "jest",
    "lint": "eslint . --max-warnings 0"
  },
  "dependencies": {
    "@tsoa/runtime": "^6.6.0",
    "@v-m-pioneer-trading/clerk-client": "https://github.com/V-M-Pioneer-Trading/clerk-client/releases/download/v2.0.1/v-m-pioneer-trading-clerk-client-2.0.1.tgz",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.7",
    "@v-m-pioneer-trading/eslint-config": "https://github.com/V-M-Pioneer-Trading/eslint-config/releases/download/v1.1.0/v-m-pioneer-trading-eslint-config-1.1.0.tgz",
    "eslint": "^10.12.0",
    "jest": "^29.7.0",
    "supertest": "^6.3.4",
    "ts-jest": "^29.2.5",
    "tsoa": "^6.6.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.71.0"
  }
}
